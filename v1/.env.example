# Optional local configuration. npm start works without creating .env.
PORT=8003
# This version is a local, single-operator development app.
HOST=127.0.0.1
# Chrome > chrome://inspect/#remote-debugging > enable remote debugging.
CHROME_DEBUG_URL=http://127.0.0.1:9222
# Optional for a non-default Chrome profile; endpoint metadata only (not cookies).
# CHROME_ACTIVE_PORT_FILE=C:/path/to/Chrome/profile/DevToolsActivePort
# No account password, session token, device password, or encryption code belongs here.
