* text=auto
*.dll binary
*.zip binary
*.wasm binary
*.png binary
*.py text eol=lf
*.sh text eol=lf
*.mjs text eol=lf

# Preserve exact SDK bytes, including XML manifests, for SHA-256 verification.
sdk/windows-x64/** binary
# Keep upstream generated browser assets unchanged.
**/public/vendor/** -whitespace
sdk/licenses/** -whitespace
